# ─────────────────────────────────────────────────────────────────────────────
# Kinetiq environment variables
#
# Local:      cp .env.example .env   (these defaults work with `pnpm infra:up`)
# Staging/production: set these in the hosting dashboards (Railway, Vercel).
#                     Never commit a real .env and never reuse local values.
#
# The API and worker validate this at startup (packages/shared/src/config.ts)
# and refuse to boot with an invalid or unsafe config.
# A test (env-example.test.ts) keeps this file and the schema in sync.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production. Must be production outside local.
NODE_ENV=development
# local | staging | production. Anything other than local enables strict checks.
APP_ENV=local
# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Origins ──────────────────────────────────────────────────────────────────
# The Next.js app. The only origin allowed by CORS and the Origin check.
WEB_ORIGIN=http://localhost:3000
# The Express API, and the port it listens on (hosts like Railway set PORT).
API_ORIGIN=http://localhost:4000
PORT=4000
# Where user uploads and renders are served from. In production this MUST be a
# different domain than the app (e.g. https://files.kinetiqcontent.com). NFR-SEC-10.
CONTENT_ORIGIN=http://localhost:9000
# Our own public files (example videos). Production: https://cdn.kinetiq.so
PUBLIC_CDN_ORIGIN=http://localhost:9000

# ── Database / Redis ─────────────────────────────────────────────────────────
# App connections. Production: the Neon *pooled* connection string.
DATABASE_URL=postgresql://kinetiq:kinetiq@localhost:5432/kinetiq
# Migrations only. Production: the Neon *direct* (unpooled) connection string.
DATABASE_DIRECT_URL=postgresql://kinetiq:kinetiq@localhost:5432/kinetiq
# BullMQ queues, rate limits, pub/sub. Must use maxmemory-policy=noeviction.
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO locally, Cloudflare R2 in production) ─────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-secret
# Private: user uploads and renders (signed URLs only).
S3_BUCKET_CONTENT=kinetiq-content
# Public: example videos and posters for the landing page.
S3_BUCKET_PUBLIC=kinetiq-public

# ── Auth ─────────────────────────────────────────────────────────────────────
# Random, at least 32 chars. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
# Cookie domain shared by app + API (required outside local), e.g. .kinetiq.so
COOKIE_DOMAIN=
# Trusted proxy hops in front of the API, used to read the real client IP.
# Local: 0. Production behind Cloudflare + Railway: 2.
TRUST_PROXY=0
# Google OAuth (required outside local).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile server key (required outside local).
TURNSTILE_SECRET_KEY=

# ── Providers ────────────────────────────────────────────────────────────────
# true = use fakes for every AI provider (zero cost). Must be false outside local.
MOCK_PROVIDERS=true
# local = render on this machine (dev only) | lambda = Remotion Lambda (required outside local).
RENDER_MODE=local
# Required when MOCK_PROVIDERS=false. Set a hard spend cap on every key (NFR-SEC-14).
# OpenRouter is needed when LLM_PROVIDER or TTS_PROVIDER is openrouter.
OPENROUTER_API_KEY=
# Needed when LLM_PROVIDER=openai.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
# Only the key of the chosen TTS_PROVIDER is required.
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# ── Voice and model choice (docs/ARCHITECTURE.md §5.1) ──────────────────────
# Switching needs only a restart. Free models (ids ending in ":free") are for
# local development only; staging and production refuse them (NFR-SEC-18).
# Who speaks the voiceover: elevenlabs | sarvam | openrouter
TTS_PROVIDER=elevenlabs
# Voice model. Required for openrouter (e.g. a free TTS model in development);
# optional otherwise (elevenlabs: eleven_multilingual_v2, sarvam: bulbul:v3).
TTS_MODEL=
# Optional: map our 5 voices to the provider's voices, e.g. sam=onyx,kira=nova,leo=echo,maya=shimmer,arjun=ash
TTS_VOICES=
# Who answers the AI roles: openrouter (any model, one key) | openai (direct with
# OPENAI_API_KEY, no OpenRouter credit needed; every model must be "openai/…").
LLM_PROVIDER=openrouter
# Model per AI role, in OpenRouter's naming, e.g. anthropic/claude-sonnet-5 or deepseek/deepseek-chat.
# Required when MOCK_PROVIDERS=false. Empty roles use LLM_MODEL_DEFAULT.
LLM_MODEL_DEFAULT=
# Used when the chosen model fails or is unavailable.
LLM_MODEL_FALLBACK=
LLM_MODEL_RESEARCH=
LLM_MODEL_DESIGN=
# The director needs the best judgment: the strongest model pays off here.
LLM_MODEL_DIRECTOR=
LLM_MODEL_SCENE_CODER=
# Must accept images (it looks at rendered stills).
LLM_MODEL_VISUAL_QA=
LLM_MODEL_EDIT=

# ── Payments (Dodo) ──────────────────────────────────────────────────────────
# Required outside local.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# test_mode | live_mode. live_mode is only allowed when APP_ENV=production.
DODO_ENV=test_mode

# ── Rendering (Remotion Lambda; required when RENDER_MODE=lambda) ───────────
REMOTION_AWS_REGION=
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
# Shared secret that signs render webhooks back to the API.
RENDER_WEBHOOK_SECRET=

# ── Email / observability ────────────────────────────────────────────────────
# Resend (required outside local; locally emails are printed to the console).
RESEND_API_KEY=
EMAIL_FROM=Kinetiq <hello@kinetiq.so>
# Optional.
SENTRY_DSN=
LANGSMITH_API_KEY=

# ── Tuning ───────────────────────────────────────────────────────────────────
# Concurrent jobs per worker replica (1–200).
WORKER_CONCURRENCY=20
# Hard deadline per job before it fails and refunds (FR-GEN-11).
JOB_DEADLINE_MINUTES=20
